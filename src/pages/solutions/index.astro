---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import FinalCta from '@/components/sections/FinalCta.astro';

const solutions = await getCollection('solutions');
---

<BaseLayout
  seoTitle="Business Solutions: AI, Automation & Systems Integration | Cornerstone"
  metaDescription="Explore the business problems Cornerstone Strategy & Integrations solves through AI, automation, systems integration, and technology strategy."
>
  <section class="bg-surface-muted py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight text-primary sm:text-4xl">Solutions</h1>
      <p class="mt-6 text-base leading-relaxed text-stone-600 sm:text-lg">
        A solution page explains the problem you're trying to solve, not the name of a technical service. Explore the
        common operational challenges Cornerstone helps businesses work through.
      </p>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          solutions.map((solution) => (
            <div class="flex flex-col rounded-xl border border-stone-200 bg-white p-6 shadow-sm">
              <h2 class="text-lg font-semibold text-primary">{solution.data.navLabel}</h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">{solution.data.summary}</p>
              <Button href={`/solutions/${solution.id}/`} variant="ghost" class="mt-4 self-start">
                Learn More
              </Button>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FinalCta
    heading="Not Sure Which Solution Fits Your Business?"
    body="Schedule a free consultation and we'll help identify the right path forward."
    primaryCta={{ text: 'Schedule a Free Consultation', link: '/contact/' }}
    secondaryCta={{ text: 'Explore All Services', link: '/services/' }}
  />
</BaseLayout>
