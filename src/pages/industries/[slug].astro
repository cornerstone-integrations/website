---
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import StubLayout from '@/layouts/StubLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('industries');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'industries'>;
}

const { entry } = Astro.props;
const { data } = entry;
---

{
  data.draft ? (
    <StubLayout title={data.title} seoTitle={data.seoTitle} metaDescription={data.metaDescription} intro={data.heroParagraphs[0]} />
  ) : (
    <PageLayout
      title={data.title}
      seoTitle={data.seoTitle}
      metaDescription={data.metaDescription}
      heroImageAlt={data.heroImageAlt}
      heroParagraphs={data.heroParagraphs}
      heroCta={data.heroCta}
      sections={data.sections}
      finalCtaHeading={data.finalCtaHeading}
      finalCtaBody={data.finalCtaBody}
      primaryCta={data.primaryCta}
      secondaryCta={data.secondaryCta}
    />
  )
}
