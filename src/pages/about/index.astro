---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import ContentSection from '@/components/sections/ContentSection.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import Button from '@/components/Button.astro';

const experience = [
  'Cornerstone was co-founded by partners who have spent their careers on opposite sides of the same challenge: running businesses and implementing the technology that supports them.',
  'Our business experience includes leading companies large and small across distribution, retail, e-commerce, logistics, real estate, and other operating environments. That experience includes building businesses from the ground up, managing growth, navigating stabilization, leading business development, and making technology investments where the results ultimately have to justify the cost.',
  'Our technical experience includes a decade of enterprise software implementation and systems integration across complex manufacturing, aerospace and defense, e-commerce, distribution, and large-scale government environments. That experience includes connecting ERP, MES, PLM, planning, e-commerce, and fulfillment systems, building real-time data workflows, leading development teams, and delivering solutions where accuracy and reliability are non-negotiable.',
  'Together, those backgrounds shape how Cornerstone approaches technology investment. We consider both what CAN be built and what SHOULD be built, with a strong emphasis on planning, execution, and return on investment.',
  'Cornerstone is more than consulting and more than IT support. We combine the perspective of people who operate businesses with the technical expertise required to implement the solution.',
];
---

<BaseLayout
  seoTitle="About Cornerstone Strategy & Integrations | Business Consulting and Technical Implementation"
  metaDescription="Cornerstone Strategy & Integrations combines experienced business leadership with software implementation and integration expertise to help companies make better technology investments and execute practical solutions."
>
  <Hero
    eyebrow="About Cornerstone"
    title="About Cornerstone Strategy & Integrations"
    nodes={['Business Leadership', 'Strategy', 'Integration Engineering', 'Execution']}
    imageAlt="Business leadership and technical integration working together to deliver practical technology solutions"
    paragraphs={[
      'Cornerstone Strategy & Integrations is a partnership between experienced business executives, programmers, and integration engineers.',
      'We partner with clients to develop practical technology solutions that support real business needs. Our approach blends business consulting with technical execution, helping companies define the path, improve efficiency, and implement solutions that create measurable value.',
      'That combination allows us to look at technology from both sides: what the business is trying to accomplish and what is required technically to make it work.',
      'Headquartered in Lancaster, Pennsylvania, Cornerstone serves a national client base.',
    ]}
  />

  <ContentSection heading="Built From Real-World Business and Technical Experience" intro={experience} layout="feature" />

  <div class="bg-white pb-14 sm:pb-16">
    <div class="mx-auto flex max-w-4xl flex-col gap-3 px-4 sm:flex-row sm:px-6 lg:px-8">
      <Button href="/how-it-works/" variant="ghost">How It Works</Button>
      <Button href="/services/" variant="ghost">Services</Button>
      <Button href="/industries/" variant="ghost">Industries</Button>
      <Button href="/contact/" variant="ghost">Contact</Button>
    </div>
  </div>

  <FinalCta
    heading="Start With a Consultation"
    body="Discuss your business objective, current technology needs, or project with Cornerstone."
    primaryCta={{ text: 'Request a Consultation', link: '/contact/' }}
  />
</BaseLayout>
