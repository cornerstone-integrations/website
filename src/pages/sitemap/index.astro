---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { primaryNav, footerNav } from '@/lib/navigation';

const industries = await getCollection('industries');
---

<BaseLayout
  seoTitle="Sitemap | Cornerstone"
  metaDescription="Browse every page on the Cornerstone Strategy & Integrations website."
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-primary">Sitemap</h1>
    <div class="mt-10 grid grid-cols-1 gap-10 sm:grid-cols-2">
      {
        primaryNav.map((item) => (
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-accent">{item.label}</h2>
            <ul class="mt-3 space-y-2">
              <li>
                <a href={item.href} class="text-sm text-primary hover:text-accent">
                  {item.label}
                </a>
              </li>
              {item.children
                ?.filter((c) => c.href !== item.href)
                .map((child) => (
                  <li>
                    <a href={child.href} class="text-sm text-stone-600 hover:text-accent">
                      {child.label}
                    </a>
                  </li>
                ))}
              {item.label === 'Industries' &&
                industries.map((ind) => (
                  <li>
                    <a href={`/industries/${ind.id}/`} class="text-sm text-stone-600 hover:text-accent">
                      {ind.data.navLabel}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-accent">Other Pages</h2>
        <ul class="mt-3 space-y-2">
          <li>
            <a href="/contact/" class="text-sm text-primary hover:text-accent">Contact and Free Consultation</a>
          </li>
          {
            footerNav.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-stone-600 hover:text-accent">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
