---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
---

<BaseLayout
  seoTitle="Contact Cornerstone: Schedule a Free Consultation"
  metaDescription="Schedule a free consultation with Cornerstone Strategy & Integrations to discuss your business challenge, current systems, and the right next step."
>
  <section class="bg-surface-muted py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight text-primary sm:text-4xl">Schedule a Free Consultation</h1>
      <p class="mt-6 text-base leading-relaxed text-stone-600 sm:text-lg">
        Tell us about your business challenge, goal, current systems, or desired outcome, and we'll help determine
        the right next step.
      </p>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-16">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-3 lg:px-8">
      <div class="lg:col-span-2">
        <ContactForm />
      </div>
      <div class="space-y-6">
        <div class="rounded-xl border border-stone-200 bg-surface-muted p-6">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-primary">Get in Touch</h2>
          <dl class="mt-4 space-y-3 text-sm text-stone-600">
            <div>
              <dt class="font-medium text-primary">Headquarters</dt>
              <dd>Lancaster, Pennsylvania</dd>
            </div>
            <div>
              <dt class="font-medium text-primary">Service Area</dt>
              <dd>Serving businesses nationwide</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
