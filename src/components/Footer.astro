---
import { primaryNav, footerNav } from '@/lib/navigation';

const currentYear = new Date().getFullYear();
// Only categories with a dropdown become their own column; single-link items
// (How It Works, About) live inline under the brand blurb instead, so the
// grid stays at logo + 4 columns and never wraps to a second row.
const navColumns = primaryNav.filter((item) => item.children && item.children.length > 0);
const singleLinks = primaryNav.filter((item) => item.label !== 'Home' && !item.children);
---

<footer class="bg-primary text-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-5">
      <div class="col-span-2 sm:col-span-3 lg:col-span-1">
        <img src="/images/logo.png" alt="Cornerstone Strategy & Integrations" class="h-9 w-auto brightness-0 invert" />
        <p class="mt-4 text-sm text-stone-300">
          National technology strategy, systems integration, AI automation, and customer API connection services
          headquartered in Lancaster, Pennsylvania.
        </p>
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
          {
            singleLinks.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-stone-200 hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        navColumns.map((item) => (
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-stone-300">{item.label}</p>
            <ul class="mt-3 space-y-2">
              {item.children!.map((child) => (
                <li>
                  <a href={child.href} class="text-sm text-stone-200 hover:text-white">
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-stone-400">&copy; {currentYear} Cornerstone Strategy & Integrations LLC. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          footerNav.map((link) => (
            <li>
              <a href={link.href} class="text-xs text-stone-300 hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
