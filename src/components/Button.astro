---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
  /** Where the button sits, for the `cta-click` analytics event, e.g. "hero" or "header". */
  location?: string;
}

const { href, variant = 'primary', class: className = '', location } = Astro.props;

const variants: Record<string, string> = {
  primary: 'bg-accent text-white hover:bg-accent-dark',
  secondary: 'bg-primary text-white hover:bg-primary-dark',
  ghost: 'border border-primary text-primary hover:bg-primary hover:text-white',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded px-6 py-3 text-sm font-semibold transition-colors duration-150',
    variants[variant],
    className,
  ]}
  data-umami-event="cta-click"
  data-umami-event-target={href}
  data-umami-event-location={location}
>
  <slot />
</a>
